        { "from": "scan_provider",    "to": "local_dataset_service","type": "persist",  "action": "saveEntry(...)", "detail": "Simpan ke Hive + gambar ke disk." },
        { "from": "local_dataset_service","to":"storage_hive",      "type": "persist",  "action": "tulis entri", "detail": "Entri ber-hash + JPG." },
        { "from": "result",           "to": "session_provider",     "type": "call",     "action": "addScan(); addXP(+10)", "detail": "XP kategori yang sudah ada." },
