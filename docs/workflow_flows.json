        { "from": "scan_provider",    "to": "rtdetr_service",          "type": "call",     "action": "detectObjects(bytes)", "detail": "Deteksi semua objek (maks 5)." },
        { "from": "scan_provider",    "to": "object_validator_service","type": "call",     "action": "detectObjectRegions()", "detail": "Fallback bila RT-DETR tak tersedia." },
        { "from": "scan_provider",    "to": "tflite_service",          "type": "call",     "action": "classifyMultipleImages(bytes, regions)", "detail": "Klasifikasi tiap crop." },
        { "from": "scan_provider",    "to": "local_dataset_service",   "type": "call",     "action": "findMatch(crop)", "detail": "Perkaya per-item dari cache." },
        { "from": "tflite_service",   "to": "scan_result",             "type": "produce",  "action": "List<ScanResult>", "detail": "Disimpan di multiResultsProvider." },
        { "from": "scanning",         "to": "multi_result",            "type": "navigate", "action": "hasil siap", "detail": "context.go('/multi-result')." },
        { "from": "multi_result",     "to": "scan_provider",           "type": "read",     "action": "multiResultsProvider", "detail": "Carousel kartu per-item." },
        { "from": "multi_result",     "to": "scan_provider",           "type": "call",     "action": "saveMultiToLocalDataset()", "detail": "SELESAI -> simpan semua item." },
        { "from": "scan_provider",    "to": "local_dataset_service",   "type": "persist",  "action": "saveEntry per item", "detail": "Tulis ke Hive + disk." },
        { "from": "multi_result",     "to": "session_provider",        "type": "call",     "action": "addScan(); addXP(...)", "detail": "XP per item." },
        { "from": "multi_result",     "to": "continue_session",        "type": "navigate", "action": "SELESAI", "detail": "context.go('/continue-session')." }
      ]
    },
    {
      "id": "mixed_gemini",
      "title": "Campuran — Analisis Ulang Gemini (opsional)",
      "summary": "Dari MultiResultScreen, 'Pindai Lagi' mengirim ulang ke Gemini untuk deteksi + bbox semua objek.",
      "steps": [
        { "from": "multi_result",  "to": "gemini_service",  "type": "read",     "action": "isConfigured", "detail": "Tombol cloud aktif hanya bila API key ada." },
        { "from": "multi_result",  "to": "scan_provider",   "type": "call",     "action": "useGeminiProvider=true; classifyMultipleWithGemini(bytes)", "detail": "reanalyzeMultiIndexProvider=null." },
        { "from": "scan_provider", "to": "gemini_service",  "type": "call",     "action": "classifyMultiple(bytes)", "detail": "Deteksi semua objek + bbox ternormalisasi." },
        { "from": "gemini_service","to": "scan_result",     "type": "produce",  "action": "List<ScanResult>", "detail": "Crop tiap item per bbox; _lastUsedGemini=true." },
        { "from": "scan_provider", "to": "multi_result",    "type": "navigate", "action": "hasil baru", "detail": "Kembali ke MultiResultScreen dengan hasil segar." }
      ]
    },
    {
      "id": "edge_cases",
      "title": "Validasi & Kasus Tepi",
      "summary": "ObjectValidatorService / RT-DETR mendeteksi masalah posisi/jumlah -> rute error spesifik -> pindai ulang.",
      "steps": [
        { "from": "camera_guide",            "to": "object_validator_service","type": "call",     "action": "validate / validateMixed", "detail": "Cek ukuran, batas, jumlah, tumpang tindih." },
        { "from": "object_validator_service","to": "scanning",                "type": "produce",  "action": "ObjectValidation / MixedObjectValidation", "detail": "Status menentukan rute." },
        { "from": "scanning",                "to": "too_large",               "type": "navigate", "action": "tooLarge", "detail": "Objek terlalu besar -> /too-large." },
        { "from": "scanning",                "to": "out_of_frame",            "type": "navigate", "action": "objectOutsideBoundary", "detail": "Objek keluar frame -> /out-of-frame." },
        { "from": "scanning",                "to": "mixed_attached",          "type": "navigate", "action": "objectsOverlapping", "detail": "Objek bersentuhan -> /mixed-attached." },
        { "from": "scanning",                "to": "mixed_partial",           "type": "navigate", "action": "objectOutsideBoundary (mixed)", "detail": "Sebagian di luar batas -> /mixed-partial." },
        { "from": "scanning",                "to": "mixed_too_many",          "type": "navigate", "action": "tooManyObjects", "detail": ">5 objek -> /mixed-too-many." },
        { "from": "scanning",                "to": "mixed_check",             "type": "navigate", "action": "sebagian ragu", "detail": "Perlu tinjauan -> /mixed-check." },
        { "from": "too_large",               "to": "camera_guide",            "type": "navigate", "action": "PINDAI ULANG", "detail": "Kembali ke panduan kamera." }
      ]
    },
    {
      "id": "cache_hit",
      "title": "Jalur Cepat — Cache Dataset Lokal",
      "summary": "Bila gambar mirip pernah dipindai, LocalDatasetService mengembalikan hasil instan tanpa inferensi ML.",
      "steps": [
        { "from": "scanning",             "to": "scan_provider",        "type": "call",    "action": "classifyImage(bytes)", "detail": "Mulai klasifikasi." },
        { "from": "scan_provider",        "to": "local_dataset_service","type": "call",    "action": "findMatch(bytes)", "detail": "Bandingkan hash + pHash (jarak Hamming <= 2)." },
        { "from": "local_dataset_service","to": "storage_hive",         "type": "read",    "action": "baca entri", "detail": "Cari kecocokan di Hive." },
        { "from": "local_dataset_service","to": "scan_result",          "type": "produce", "action": "ScanResult (confidence=1.0)", "detail": "Hasil dari cache, lewati RT-DETR/TFLite/Gemini." },
        { "from": "scan_provider",        "to": "result",               "type": "navigate","action": "tampilkan hasil", "detail": "Langsung ke ResultScreen." }
      ]
    },
    {
      "id": "session_end",
      "title": "Akhiri Sesi & Persistensi",
      "summary": "Selesai sesi -> simpan UserSession, tampilkan statistik, kembali ke idle.",
      "steps": [
        { "from": "continue_session", "to": "scan_provider",    "type": "call",     "action": "clearResult()", "detail": "LANJUT PINDAI -> bersihkan & kembali ke /mode-select." },
        { "from": "continue_session", "to": "mode_select",      "type": "navigate", "action": "LANJUT PINDAI", "detail": "context.go('/mode-select')." },
        { "from": "continue_session", "to": "session_provider", "type": "call",     "action": "addScan()", "detail": "SELESAI SESI." },
        { "from": "session_provider", "to": "session_service",  "type": "call",     "action": "saveSession(state)", "detail": "Persist UserSession." },
        { "from": "session_service",  "to": "storage_prefs",    "type": "persist",  "action": "tulis SharedPreferences", "detail": "Nama, XP, jumlah scan/koreksi." },
        { "from": "continue_session", "to": "thank_you",        "type": "navigate", "action": "SELESAI SESI", "detail": "context.go('/thank-you')." },
        { "from": "thank_you",        "to": "user_session",     "type": "read",     "action": "statistik sesi", "detail": "totalXP, scanCount, uniqueCategoryCount, accuracyPercent." },
        { "from": "thank_you",        "to": "idle",             "type": "navigate", "action": "ketuk", "detail": "context.go('/') kembali ke screensaver." }
      ]
    }
  ]
}
